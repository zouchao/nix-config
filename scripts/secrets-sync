#!/usr/bin/env bash
# secrets-sync —— 从 Bitwarden 的 Secure Note 生成 ~/.config/zsh/secrets.zsh
#
# 秘钥的权威来源在 Bitwarden（条目：zsh-secrets，Secure Note 类型）。
# 本脚本只做「拉取 + 落盘」，秘钥明文永远不进 git。
#
# 用法：secrets-sync（无 BW_SESSION 时会交互式解锁，输一次主密码）
set -euo pipefail

NOTE_NAME="zsh-secrets"
TARGET="$HOME/.config/zsh/secrets.zsh"

command -v bw >/dev/null || { echo "错误：找不到 bw（bitwarden-cli）" >&2; exit 1; }

# 没有会话就解锁；--raw 只把 session key 打到 stdout
if [ -z "${BW_SESSION:-}" ]; then
  export BW_SESSION="$(bw unlock --raw)"
fi

# CLI 读的是本地缓存，网页端新建的条目必须先 sync
bw sync >/dev/null

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

if ! bw get notes "$NOTE_NAME" > "$TMP"; then
  echo "错误：拉取笔记 '$NOTE_NAME' 失败" >&2
  exit 1
fi

# 空内容拒绝覆盖，防止误清空现有秘钥
if [ ! -s "$TMP" ]; then
  echo "错误：笔记内容为空，中止（不覆盖现有文件）" >&2
  exit 1
fi

mkdir -p "$(dirname "$TARGET")"
install -m 600 "$TMP" "$TARGET"
echo "已同步 → $TARGET"
